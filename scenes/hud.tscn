[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hud_inspect.gd" id="1"]

[node name="HUD" type="CanvasLayer"]
layer = 20
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="StatusBar" type="PanelContainer" parent="Root"]
layout_mode = 0
offset_left = 8.0
offset_top = 8.0
offset_right = 520.0
offset_bottom = 110.0

[node name="Margin" type="MarginContainer" parent="Root/StatusBar"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="StatusText" type="RichTextLabel" parent="Root/StatusBar/Margin"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "status"

[node name="InspectPanel" type="PanelContainer" parent="Root"]
layout_mode = 0
offset_left = 1280.0
offset_top = 8.0
offset_right = 1592.0
offset_bottom = 320.0

[node name="Margin" type="MarginContainer" parent="Root/InspectPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Root/InspectPanel/Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="Root/InspectPanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "INSPECT"

[node name="InspectText" type="RichTextLabel" parent="Root/InspectPanel/Margin/VBox"]
layout_mode = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "..."

[node name="Buttons" type="HBoxContainer" parent="Root"]
layout_mode = 0
offset_left = 8.0
offset_top = 120.0
offset_right = 420.0
offset_bottom = 156.0

[node name="PauseBtn" type="Button" parent="Root/Buttons"]
layout_mode = 2
text = "Pause/Resume (Space)"

[node name="Sp1" type="Button" parent="Root/Buttons"]
layout_mode = 2
text = "1x"

[node name="Sp2" type="Button" parent="Root/Buttons"]
layout_mode = 2
text = "2x"

[node name="Sp4" type="Button" parent="Root/Buttons"]
layout_mode = 2
text = "4x"

[connection signal="pressed" from="Root/Buttons/PauseBtn" to="." method="_on_pause_pressed"]
[connection signal="pressed" from="Root/Buttons/Sp1" to="." method="_on_speed1"]
[connection signal="pressed" from="Root/Buttons/Sp2" to="." method="_on_speed2"]
[connection signal="pressed" from="Root/Buttons/Sp4" to="." method="_on_speed4"]
