; Engine configuration file.
; Deep Station — pixel six-room shell. Legacy cutaway: --legacy-cutaway
; Godot 4.3

config_version=5

[application]

config/name="Deep Station"
config/description="Pixel deep-sea station. Six HUD rooms. Legacy oil-rig cutaway via --legacy-cutaway."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

environment/defaults/default_clear_color=Color(0.024, 0.063, 0.094, 1)
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[ai_station]

legacy_cutaway=false

[input]

speed_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":49,"key_label":0,"unicode":49,"location":0,"echo":false,"script":null)
]
}
