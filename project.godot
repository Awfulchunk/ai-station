; Engine configuration file.
; Jay AI Station — Fixed-Cam Test (CODI)
; Godot 4.3

config_version=5

[application]

config/name="AI Station Fixed-Cam Test"
config/description="Fixed-camera station management test. A+B+C look. Extreme Spec modules. No trench/sub this test."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

